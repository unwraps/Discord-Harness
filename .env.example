# ==========================================
# Discord LLM Harness Configuration
# ==========================================

# Required: Your Discord Bot Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Default Model to use when no channel/thread override is set
# Format examples:
# - openrouter/anthropic/claude-3.5-sonnet
# - openrouter/deepseek/deepseek-chat
# - deepseek/deepseek-chat
# - gpt-4o
# - gemini/gemini-2.0-flash
# - ollama/llama3
DEFAULT_MODEL=openrouter/deepseek/deepseek-chat

# Default System Prompt
DEFAULT_SYSTEM_PROMPT=You are a versatile, intelligent AI assistant inside a Discord server. You have access to specialized tools called skills. Be concise, direct, helpful, and use markdown formatting naturally.

# Maximum conversation turns to keep in context buffer
MAX_HISTORY_TURNS=20

# Temperature (0.0 to 2.0)
DEFAULT_TEMPERATURE=0.7

# Default per-user daily token cap (total tokens, resets UTC midnight).
# 0 = unlimited. Admins can override per user with /limit set.
# DEFAULT_DAILY_TOKEN_LIMIT=0

# ==========================================
# Provider API Keys
# Fill in whichever providers you want to use
# ==========================================

# OpenRouter (Access to DeepSeek, Claude, Llama, Gemini, etc.)
OPENROUTER_API_KEY=

# DeepSeek Official API
DEEPSEEK_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Groq API
GROQ_API_KEY=

# Mistral API
MISTRAL_API_KEY=

# ==========================================
# Custom / Local Providers (e.g. OpenCode, Ollama, LM Studio, vLLM)
# ==========================================
# CUSTOM_API_BASE=http://localhost:11434/v1
# CUSTOM_API_KEY=

# ==========================================
# Voice (Edge TTS readout in voice channels)
# ==========================================
# Default TTS voice, e.g. en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
# TTS_VOICE=en-US-AriaNeural
